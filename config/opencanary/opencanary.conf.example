{
  "//": "Najważniejsze ustawienia honeypota na honeypi. Pełny plik tworzy: sudo env PATH=/opt/opencanary/bin:$PATH opencanaryd --copyconfig",
  "//2": "Plik na Raspberry: /etc/opencanaryd/opencanary.conf (właściciel root). Zmiany wprowadzam skryptem z docs/03, krok 10.",
  "//security": "Nie wrzucaj do repo prawdziwego configu z adresami ani kluczami.",

  "device.node_id": "honeypi",

  "ftp.enabled": true,
  "ftp.port": 21,
  "ftp.banner": "FTP server ready",

  "http.enabled": true,
  "http.port": 80,
  "http.banner": "Apache/2.4.62 (Debian)",
  "http.skin": "nasLogin",

  "ssh.enabled": true,
  "ssh.port": 22,
  "ssh.version": "SSH-2.0-OpenSSH_9.2p1 Debian-2+deb12u3",

  "logger": {
    "class": "PyLogger",
    "kwargs": {
      "handlers": {
        "file": {
          "class": "logging.FileHandler",
          "filename": "/var/log/opencanary/opencanary.log"
        }
      }
    }
  }
}
